OPENAI_API_KEY=''
EMBEDDING_MODEL=''

DB_HOST=''
DB_PORT=''
DB_NAME=''
DB_USER=''
DB_PASSWORD=''

# DB_NAME/DB_USER/DB_PASSWORD는 루트 .env의 POSTGRES_* 값과 맞추세요.
# Docker Compose는 DB_HOST=db로 지정합니다.
# 호스트에서 직접 실행할 때는 DB_HOST=127.0.0.1, DB_PORT=5432를 사용하세요.

# 메일 설정 (Docker Compose: Mailpit, 호스트 실행: EMAIL_HOST=127.0.0.1)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=webmaster@localhost

# Gmail 등 외부 SMTP는 앱 비밀번호를 사용하세요.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=your@gmail.com
# 앱 비밀번호: https://myaccount.google.com/apppasswords

# 실행 환경 > backend/.env > 루트 .env 순으로 우선합니다.
# 기존 루트 .env의 메일 설정도 fallback으로 지원합니다.