# 관광공사 API키
KTO_TOUR_APT_KEY = ...

# 카카오 API 키
KAKAO_REST_API_KEY = ...
KAKAO_JS_API_KEY = ...

# 티맵 대중교통 혼합 API 키 (대중교통의 경우 하루 10건 호출 제한)
TMAP_API_KEY = ...

# 네이버 API키 및 ID
# (MAPS는 지도시각화 , LOCAL은 지역,장소 검색)
# (MAPS의 경우 이후 개발 주소가 생기면 수정/등록해야함)

NAVER_MAPS_ID = ...
NAVER_MAPS_API_KEY = ...

NAVER_LOCAL_CLIENT_ID = ...
NAVER_LOCAL_API_KEY = ...

# ODsay 대중교통 API 키 ( 개발 주소가 생기면 수정/등록해야함)
# ODSAY_API_KEY = ...

# 메일 설정 (로컬 Docker Compose: Mailpit)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=webmaster@localhost

# Gmail 등 외부 SMTP를 사용할 때만 아래 값을 실제 환경에 맞게 바꿉니다.
# Gmail은 일반 계정 비밀번호가 아닌 앱 비밀번호를 사용하세요.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=your@gmail.com
# 앱 비밀번호: https://myaccount.google.com/apppasswords

# 실제 값은 추적되지 않는 프로젝트 루트 .env 또는 실행 환경에 설정합니다.
# Docker Compose는 루트 .env를 backend 컨테이너에 주입합니다(파일이 없어도 실행 가능).
# Compose의 DB_HOST는 db로 지정됩니다. 호스트에서 backend를 직접 실행할 때는
# DB_HOST=127.0.0.1(기본값), EMAIL_HOST=127.0.0.1을 사용하세요.
