# Copy this file to frontend/.env.local. Never commit the API key.
# demo | openai | backend
CHAT_PROVIDER=demo

# Used only by the Next.js server when CHAT_PROVIDER=openai.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Full chat endpoint URL, used only when CHAT_PROVIDER=backend.
CHAT_BACKEND_URL=

# Browser SDK key: use the Kakao JavaScript key, never the REST API key.
# Register http://localhost:3000 (local) and http://localhost (Docker) in Kakao SDK domains.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Leave blank to keep basic writing. Set only with the appropriate CKEditor license.
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=
